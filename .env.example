# ====================================================
# Web Push VAPID Keys
# ====================================================
# Generate your own keys anytime with: npx web-push generate-vapid-keys
# 1. Exposed to Vite React client:
VITE_VAPID_PUBLIC_KEY=your_public_vapid_key_here

# 2. Used by Vercel Serverless Function (/api/cron-remind):
VAPID_PUBLIC_KEY=your_public_vapid_key_here
VAPID_PRIVATE_KEY=your_private_vapid_key_here
VAPID_MAILTO=mailto:your-email@domain.com

# ====================================================
# Free Upstash Redis (1-Click Integration in Vercel)
# ====================================================
# In Vercel: Project Settings -> Storage -> Connect Upstash Redis
# (These two variables are automatically injected by Vercel)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: Protect /api/cron-remind from external manual hits
CRON_SECRET=

# ====================================================
# Admin Notifications Dashboard Security PIN
# ====================================================
# Mandatory 4-6 digit passcode to unlock /admin and broadcast pushes
ADMIN_PIN=your_custom_pin_here
